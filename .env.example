# Copy to .env (gitignored) and adjust. No secrets belong in this file.
WMAD_PORT=4546
# Demo team instead of the host's real sessions. Keep 1 for a public preview.
WMAD_DEMO=1
# Host header allow list. "*" accepts any Host; admin routes stay gated.
WMAD_ALLOWED_HOSTS=*
# Only behind your own reverse proxy (see docs/run.md). Off by default.
# WMAD_TRUST_PROXY=1
# LAN admin token: prefer a file (Docker secret), never commit its value.
# WMAD_ADMIN_TOKEN_FILE=/run/secrets/wmad_admin_token
# WMAD_ADMIN_TOKEN=
